# SynapseAI Environment Variables
# See docs/CONFIGURATION.md for full options

# Required: OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Optional: Anthropic API Key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# Optional: DeepSeek API Key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Optional: Search API Keys
TAVILY_API_KEY=your-tavily-api-key
SERPER_API_KEY=your-serper-api-key

# Optional: Browser Configuration
# GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Server Configuration
# BIND_HOST=127.0.0.1
# PORT=2026

# Optional: Database Configuration
# DATABASE_URL=sqlite:///./synapse.db
# DATABASE_URL=postgresql://user:pass@localhost/synapse

# Optional: Redis Configuration (for multi-worker mode)
# REDIS_URL=redis://localhost:6379

# Optional: Sandboxed Code Execution
# E2B_API_KEY=your-e2b-api-key

# Optional: Monitoring
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
